{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "levantc/levantc",
    "description": "LevantC Foundation Layer — the central Laravel-native platform core and shared system kernel that all LevantC modules extend.",
    "type": "library",
    "keywords": [
        "levantc",
        "laravel",
        "platform-core",
        "foundation-layer",
        "modular-architecture",
        "ddd",
        "ecosystem"
    ],
    "homepage": "https://www.levantc.io",
    "license": "proprietary",
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "founder.muath@levantc.io",
            "role": "Lead Engineer"
        }
    ],
    "support": {
        "email": "founder.muath@levantc.io",
        "issues": "https://github.com/levantc/levantc/issues",
        "source": "https://github.com/levantc/levantc"
    },
    "require": {
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "Levantc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Levantc\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Levantc\\Providers\\ModuleServiceProvider",
                "Levantc\\Providers\\BroadcastServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
